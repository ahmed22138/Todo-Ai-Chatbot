# Database Configuration
# Get from: https://neon.tech (free PostgreSQL database)
# IMPORTANT: Change postgresql:// to postgresql+asyncpg:// for async support
# Format: postgresql+asyncpg://username:password@host/database
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname

# JWT Authentication
# Generate a secure random string (32+ characters)
# Command: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-here-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# OpenAI Configuration
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration
# Add your frontend URLs (comma-separated, no spaces)
# For local development: http://localhost:5173
# For production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Application Environment (optional)
ENVIRONMENT=development

# Optional: Custom port for backend
# PORT=8000
# HOST=0.0.0.0
